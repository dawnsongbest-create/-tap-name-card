.template-gallery {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
}

.template-gallery--state {
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-gallery__header {
  padding: 12rpx 8rpx 40rpx;
}

.template-gallery__title {
  color: #1d1d1f;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.18;
}

.template-gallery__description {
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 28rpx;
  line-height: 1.55;
}

.template-gallery__list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.template-gallery__item {
  overflow: hidden;
  border: 1rpx solid #e2e2e5;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 52rpx rgba(29, 29, 31, 0.08);
}

.template-gallery__preview-window {
  height: 760rpx;
  overflow: hidden;
  background: #efefef;
}

.template-gallery__meta {
  padding: 30rpx 30rpx 32rpx;
}

.template-gallery__name {
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 650;
  line-height: 1.3;
}

.template-gallery__style {
  margin-top: 10rpx;
  color: #6e6e73;
  font-size: 25rpx;
  line-height: 1.6;
}

.template-gallery__preview-action {
  width: 100%;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: #1d1d1f;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.template-gallery__preview-action::after {
  border: 0;
}

@media screen and (max-width: 350px) {
  .template-gallery {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }

  .template-gallery__header {
    padding-right: 6rpx;
    padding-left: 6rpx;
  }

  .template-gallery__title {
    font-size: 48rpx;
  }

  .template-gallery__preview-window {
    height: 680rpx;
  }
}
