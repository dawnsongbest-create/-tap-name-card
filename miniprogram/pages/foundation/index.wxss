.foundation {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.foundation__header {
  padding: 12rpx 4rpx 36rpx;
}

.foundation__eyebrow {
  color: #6e6e73;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.foundation__title {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.foundation__description {
  margin-top: 20rpx;
  color: #424245;
  font-size: 28rpx;
  line-height: 1.7;
}

.foundation__meta {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.foundation__meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  border-bottom: 1rpx solid #e5e5e7;
  font-size: 28rpx;
}

.foundation__meta-row:last-child {
  border-bottom: 0;
}

.foundation__meta-value {
  color: #6e6e73;
}

.foundation__section {
  margin-top: 40rpx;
}

.foundation__section-title {
  margin: 0 4rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.foundation__state-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.foundation__retry-count {
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  text-align: center;
}

.foundation__notice {
  margin-top: 40rpx;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  background: #e8f2ff;
  color: #174ea6;
  font-size: 26rpx;
  line-height: 1.6;
}
