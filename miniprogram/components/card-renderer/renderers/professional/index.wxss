.renderer-shell {
  box-sizing: border-box;
  min-height: 360rpx;
  padding: 40rpx;
  border: 1rpx dashed #a1a1a6;
  border-radius: 24rpx;
  background: #ffffff;
}

.renderer-shell__eyebrow {
  color: #6e6e73;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.renderer-shell__name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.renderer-shell__message {
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.6;
}
