{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "vitest/globals", "node"]
  },
  "include": [
    "cloudfunctions/**/*.ts",
    "miniprogram/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "miniprogram_npm", "coverage", "dist"]
}
